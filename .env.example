# 数据库配置模板
# 复制为 .env 并填入真实值

DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=opsdb
DB_PORT=23306

ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# Redis 限流：所有后端实例连接同一个 Redis 并使用相同前缀
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OPS_RATE_LIMIT_TYPE=redis
OPS_RATE_LIMIT_REDIS_PREFIX=ops:local:ratelimit:v1:
OPS_RATE_LIMIT_ASK_LIMIT=30
OPS_RATE_LIMIT_ASK_PERIOD=60
OPS_RATE_LIMIT_DIAGNOSIS_LIMIT=5
OPS_RATE_LIMIT_DIAGNOSIS_PERIOD=60
